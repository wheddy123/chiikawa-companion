{
  "appId": "com.chiikawa.ai",
  "productName": "Chiikawa AI",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "assets/**/*"
  ],
  "extraResources": [
    {
      "from": "src/main/platform/desktop-helper.swift",
      "to": "desktop-helper.swift"
    },
    {
      "from": "dist/main/platform/desktop-helper",
      "to": "desktop-helper",
      "filter": ["*"]
    },
    {
      "from": "dist/main/platform/raycast-watcher",
      "to": "raycast-watcher",
      "filter": ["*"]
    },
    {
      "from": "scripts",
      "to": "scripts",
      "filter": ["chiikawa-notify.*", "raycast-toggle.*"]
    }
  ],
  "mac": {
    "icon": "assets/icon.icns",
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64", "x64"]
      }
    ],
    "category": "public.app-category.developer-tools",
    "identity": null,
    "gatekeeperAssess": false,
    "hardenedRuntime": false
  },
  "dmg": {
    "title": "${productName} ${version}",
    "contents": [
      {
        "x": 140,
        "y": 190,
        "type": "file"
      },
      {
        "x": 400,
        "y": 190,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 540,
      "height": 380
    },
    "background": "assets/dmg-background.png",
    "iconSize": 128
  },
  "win": {
    "icon": "assets/icon.ico",
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  }
}
