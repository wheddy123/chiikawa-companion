{
  "name": "chiikawa-companion",
  "version": "1.2.0",
  "description": "3D Desktop Mascot for Coding Agents",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "npm run build && electron .",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist/main/index.js",
    "build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node20 --external:electron --outfile=dist/preload/index.js",
    "build:renderer": "vite build",
    "build:native": "node scripts/build-native.js",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer && npm run build:native",
    "start": "npm run build && electron .",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:mac": "npm run build && electron-builder --mac --arm64 --x64",
    "dist": "npm run build && electron-builder"
  },
  "dependencies": {
    "three": "^0.174.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/three": "^0.174.0",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2",
    "vite": "^6.2.0"
  }
}
